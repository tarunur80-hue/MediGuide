# .env.example
#
# HOW TO USE THIS FILE:
# 1. Copy this file and rename the copy to ".env" (no "example" in the name)
# 2. Fill in real values below
# 3. NEVER commit the real .env file to GitHub -- it's already in .gitignore
#
# ANTHROPIC_API_KEY is used starting Day 4 for the AI symptom checker.
# It's fine to leave it blank today.
ANTHROPIC_API_KEY=

# SECRET_KEY is used by Flask to secure user sessions (keeps you logged in
# safely). It should be a long, random, unpredictable string.
# You can generate one by running this in your terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
